{
  "name": "@arenalive/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipi e schemi zod dei messaggi agente-server-web.",
  "type": "module",
  "exports": {
    ".": {
      "@arenalive/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "schemi:agente": "tsx --conditions=@arenalive/source scripts/genera-schemi-agente.ts"
  },
  "dependencies": {
    "@arenalive/dvw-parser": "workspace:*",
    "@arenalive/volley-stats": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arenalive/dvw-simulator": "workspace:*",
    "tsx": "^4.23.15"
  }
}
