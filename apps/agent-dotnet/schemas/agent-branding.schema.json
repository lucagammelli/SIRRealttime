{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "onPrimary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "onAccent": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "onBackground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "required": [
        "primary",
        "onPrimary",
        "accent",
        "onAccent",
        "background",
        "onBackground"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name",
    "colors"
  ],
  "additionalProperties": false
}
