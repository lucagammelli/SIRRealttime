{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "duplicate",
        "needSnapshot"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9007199254740991
    },
    "lineCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "status",
    "seq",
    "lineCount"
  ]
}
