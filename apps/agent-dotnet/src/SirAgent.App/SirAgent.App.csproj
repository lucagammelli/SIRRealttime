<Project Sdk="Microsoft.NET.Sdk">
  <!-- sir-agent.exe: finestra WinForms, console, esecuzione singola e servizio di Windows nello stesso eseguibile.
       Pubblicato come exe unico autosufficiente win-x64 (scripts/costruisci-agente-dotnet.sh). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>sir-agent</AssemblyName>
    <RootNamespace>SirAgent.App</RootNamespace>
    <ApplicationIcon>sir-agent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>SIRRealtime Agent</Title>
    <Description>Agente SIRRealtime: legge il file .dvw di DataVolley e invia le azioni al server</Description>
    <!-- Exe unico: runtime incluso, compresso, librerie native estratte all'avvio. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SirAgent.Core\SirAgent.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ServiceBase per la modalità servizio (pacchetto Microsoft, parte di dotnet/runtime). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>
</Project>
