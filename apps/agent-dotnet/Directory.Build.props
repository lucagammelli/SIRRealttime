<Project>
  <!-- Comune a tutti i progetti dell'agente C#. La versione è quella del package.json alla radice: la passa scripts/costruisci-agente-dotnet.sh
       (-p:Version, -p:FileVersion, -p:InformationalVersion); i valori qui sotto servono solo per build a mano. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <!-- Proprietà dell'exe di Windows: «Versione file» e «Versione prodotto» (a.b.c+commit). -->
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Company>ArenaLive</Company>
    <Product>ArenaLive Agent</Product>
    <Authors>ArenaLive</Authors>
    <Copyright>Copyright © 2026 ArenaLive</Copyright>
    <NeutralLanguage>it-IT</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
