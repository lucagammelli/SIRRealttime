# Variabili d'ambiente di SIRRealtime.
# Copia questo file in `.env` (mai nel repository) e compila i valori.

# --- Server (apps/server) ---
# Connessione Postgres. Con docker compose viene composta da POSTGRES_* e questa riga non serve.
# In sviluppo senza Docker: `pglite:memory` (database in memoria) o `pglite:<cartella>` (PGlite su disco).
DATABASE_URL=postgres://sir:<password>@localhost:5432/sir
# Porta HTTP del server (default 8090).
PORT=8090
# Indirizzo di ascolto: 127.0.0.1 in sviluppo, 0.0.0.0 nel container (default 127.0.0.1).
HOST=127.0.0.1
# Origine del portale (schema://host[:porta]): unica ammessa da CORS e dal controllo Origin delle rotte admin.
CORS_ORIGIN=http://localhost:5173
# Cookie di sessione con attributo Secure (true in produzione con HTTPS; false solo in sviluppo su http).
COOKIE_SECURE=true
# Durata della sessione admin in ore (default 12, massimo 720).
SESSION_TTL_HOURS=12
# Primo utente admin, creato all'avvio solo se non esiste ancora nessun utente (password di almeno 12 caratteri).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Indirizzo pubblico del portale: i link di condivisione sono `${PUBLIC_BASE_URL}/live/<token>`.
PUBLIC_BASE_URL=http://localhost:5173
# Livello dei log pino: fatal, error, warn, info, debug, trace, silent (default info).
LOG_LEVEL=info
# true solo dietro un reverse proxy fidato (usa X-Forwarded-For per IP e rate limit; default false).
TRUST_PROXY=false
# Richieste al minuto per IP (interi da 1 a 100000): login, ingest dell'agente, link pubblici, area riservata.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_INGEST=600
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_ADMIN=300
# Righe scout massime salvate per una partita: oltre, l'ingest risponde 413 (default 20000).
MATCH_MAX_LINES=20000

# --- docker compose ---
# Database Postgres del container (la password va usata anche nell'URL: solo lettere, cifre, - e _).
POSTGRES_DB=sir
POSTGRES_USER=sir
POSTGRES_PASSWORD=
# Indirizzo dell'host su cui pubblicare la porta 8090 del server (default 127.0.0.1, solo locale).
SERVER_BIND=127.0.0.1
