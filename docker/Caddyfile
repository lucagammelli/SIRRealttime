# Proxy TLS di produzione (docker/compose.produzione.yml). SIR_HOSTNAMES e ACME_EMAIL arrivano dal .env.
# SIR_TLS_MODE (nel .env, scritto da installa-produzione.sh) sceglie il certificato:
#  - letsencrypt: Caddy ottiene e rinnova da solo i certificati Let's Encrypt per ogni hostname;
#  - interno: certificati firmati dalla CA locale di Caddy (radice generata sul server), per hostname non pubblici;
#    la radice pubblica (mai la chiave) è servita su /sirrealtime-ca.crt.
# In entrambi i modi 80 -> 443 è reindirizzato.
# Nessun access log: nel percorso ci sono i token dei link (/live/<token>, /l/<codice>) che nginx maschera nei suoi log.
{
	email {$ACME_EMAIL}

	# Log di runtime senza l'oggetto «request» (URI, intestazioni, IP): un errore del reverse_proxy altrimenti
	# scriverebbe il percorso con i token dei link.
	log {
		level WARN
		format filter {
			wrap console
			fields {
				request delete
			}
		}
	}
}

# Snippet scelto da «import modo_{$SIR_TLS_MODE}». Con letsencrypt non aggiunge nulla (comportamento predefinito di Caddy).
(modo_letsencrypt) {
}

(modo_interno) {
	tls internal

	# Solo la radice pubblica, copiata da installa-produzione.sh in una cartella montata in sola lettura.
	handle /sirrealtime-ca.crt {
		root * /srv/ca
		header Content-Type application/x-x509-ca-cert
		file_server
	}
}

{$SIR_HOSTNAMES} {
	import modo_{$SIR_TLS_MODE}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Il Host originale arriva invariato a nginx e al server, che da lì sceglie il cliente.
	reverse_proxy web:8080 {
		header_up X-Forwarded-For {remote_host}
		flush_interval -1
	}
}
